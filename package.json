{
  "name": "zaraos-driverstation",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.3.4",
  "description": "New driver station for ZaraOS robots.",
  "main": "index.js",
  "scripts": {
    "test": "turbo test",
    "preinstall": "pnpx only-allow@1.2.2 pnpm",
    "dev": "turbo dev",
    "build": "turbo run build",
    "lint": "turbo run lint lint:root",
    "lint:check": "turbo run lint:check lint:root:check",
    "format": "turbo run format format:root",
    "format:check": "turbo run format:check format:root:check",
    "typecheck": "turbo run typecheck typecheck:root",
    "lint:root": "eslint --fix",
    "lint:root:check": "eslint",
    "format:root": "oxfmt --write --disable-nested-config .",
    "format:root:check": "oxfmt --check --disable-nested-config .",
    "typecheck:root": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KoalbyMQP/ZaraOS-DriverStation.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KoalbyMQP/ZaraOS-DriverStation/issues"
  },
  "homepage": "https://github.com/KoalbyMQP/ZaraOS-DriverStation#readme",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/oxfmt-config": "workspace:*",
    "@types/node": "20.19.37",
    "eslint": "^9",
    "oxfmt": "0.70.0",
    "turbo": "^2.11.3",
    "typescript": "6.0.3"
  }
}
